# Copy this file to .env.local and fill in the values. See doc/wiki/setup.md.

# Supabase project settings > API. These two values are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never put these in a NEXT_PUBLIC variable.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Optional: the Claude model that reads label photos. Default: claude-opus-5-5.
# LABEL_MODEL=
