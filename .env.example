# Copy this file to .env.local and fill in the values. See doc/wiki/setup.md.

# Supabase dashboard > Project Settings > API Keys. Use the new keys, not the legacy anon and service_role keys.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe in the browser: row-level security limits it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never put these in a NEXT_PUBLIC variable.
# Secret key (starts with sb_secret_). Supabase refuses it from a browser.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Optional: the Claude model that reads label photos. Default: claude-opus-5-5.
# LABEL_MODEL=
